{
  "name": "ap-research-grader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "verify:custom": "npx tsx scripts/verify-custom-test-papers.ts",
    "regression": "npx tsx scripts/regression-all-samples.ts && npx tsx scripts/test-completeness-pipeline.ts",
    "seminar:grade": "npx tsx scripts/grade-seminar-samples.ts",
    "seminar:regression": "npx tsx scripts/seminar-regression.ts",
    "seminar:cb-regression": "npx tsx scripts/seminar-cb-regression.ts",
    "seminar:all-regression": "npm run seminar:regression && npm run seminar:cb-regression",
    "seminar:golden-irr": "npx tsx scripts/seminar-golden-batch-irr.ts",
    "seminar:batch3": "npx tsx scripts/seminar-batch3-calibration.ts",
    "seminar:word-count-guard": "npx tsx scripts/verify-regression-word-count-bands.ts",
    "seminar:word-count-papers": "npx tsx scripts/generate-word-count-test-papers.ts && npx tsx scripts/grade-word-count-test-papers.ts",
    "seminar:benchmark": "npx tsx scripts/seminar-benchmark.ts",
    "seminar:preflight": "npx tsx scripts/seminar-preflight-verify.ts",
    "seminar:build-phrases": "npx tsx scripts/build-iwa-phrase-regex.ts && npx tsx scripts/build-iwa-penalty-regex.ts && npx tsx scripts/build-irr-phrase-regex.ts",
    "seminar:build-320": "npx tsx scripts/build-seminar-320-patterns.ts",
    "seminar:verify-320": "npx tsx scripts/seminar-320-verify.ts",
    "test:completeness": "npx tsx scripts/test-completeness-pipeline.ts",
    "test:incomplete": "npx tsx scripts/test-incomplete-submission.ts",
    "generate:synthetic": "npx tsx scripts/generate-synthetic-papers.ts",
    "grade:synthetic": "npx tsx scripts/run-synthetic-grading.ts",
    "accuracy:report": "npx tsx scripts/measure-accuracy.ts && npx tsx scripts/print-accuracy-report.ts",
    "benchmark": "npx tsx scripts/benchmark.ts",
    "compare:benchmarks": "npx tsx scripts/compare-benchmarks.ts",
    "errors:extract": "npx tsx scripts/extract-error-patterns.ts",
    "test:synthetic": "npx tsx scripts/test-synthetic-system.ts",
    "test:synthetic-pdf": "npx tsx scripts/test-synthetic-pdf-retention.ts",
    "ml:full": "npx tsx scripts/generate-synthetic-papers.ts --full && npx tsx scripts/run-synthetic-grading.ts --full && npx tsx scripts/measure-accuracy.ts && npx tsx scripts/print-accuracy-report.ts && npx tsx scripts/extract-error-patterns.ts && npx tsx scripts/benchmark.ts --full"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "mammoth": "^1.12.0",
    "next": "^15.1.6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
