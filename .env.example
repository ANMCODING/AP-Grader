# Required for the analytical engine (Claude API)
ANTHROPIC_API_KEY=your_key_here

# Optional — defaults to claude-sonnet-4-20250514
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Private usage stats (Vercel: add Upstash Redis from Marketplace, then set these)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Password for https://your-site.vercel.app/admin (counts only — no paper text stored)
# GRADER_ADMIN_SECRET=choose-a-long-random-password
